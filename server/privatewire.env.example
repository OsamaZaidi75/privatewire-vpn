# Example server configuration. Copy to `privatewire.env` and fill in.
# NEVER commit `privatewire.env` (it is git-ignored). No secrets live here —
# keys are generated at deploy time and stored under /etc/wireguard (0600).

# Public IPv4 (or DNS name) of this VPN server, used as client Endpoint.
SERVER_PUBLIC_IP=203.0.113.10

# Outbound interface for NAT (the interface with internet access).
# Auto-detected at deploy time if left empty.
SERVER_PRIVATE_INTERFACE=

# UDP port WireGuard listens on. Single exposed port.
WIREGUARD_PORT=51820

# VPN subnet. Server takes .1; clients get .2, .3, ... (/24 = up to 253 clients).
WIREGUARD_NETWORK=10.8.0.0/24

# DNS advertised to clients (Unbound on this host, or public resolvers).
DNS_SERVER=10.8.0.1

# Optional: also push a public fallback DNS (comma-separated second entry).
# DNS_SERVER_FALLBACK=1.1.1.1

# Optional IPv6 overlay (ULA). Empty = IPv4-only, and server config blocks
# IPv6 leaks client-side via documentation + full-tunnel AllowedIPs guidance.
WIREGUARD_NETWORK_V6=
